+/* Initial traversal needs the same continuation distance as later pages.
+ * Version 1 tail copies (physical pages 2/3) represent file_offset, not 2/3.
+ * Reject impossible geometry instead of scanning for a plausible record. */
+static int initial_skipped(const struct BUFFER *buf,
+		const struct BUFFER *prevbuf)
+{
+	u64 logical = buf->num;
+	u64 base = log_major < 2 ? BASEBLKS : BASEBLKS2;
+	u64 pages = logfilesz >> blockbits;
+	u64 previous;
+	if (!prevbuf)
+		return 0;
+	if ((log_major < 2) && (logical >= RSTBLKS) && (logical < BASEBLKS)) {
+		u64 offset = le64_to_cpu(buf->block.record.copy.file_offset);
+		if (offset & (blocksz - 1))
+			return -1;
+		logical = offset >> blockbits;
+	}
+	previous = prevbuf->num;
+	if (logical < base || logical >= pages || previous < base
+	    || previous >= pages || previous == logical)
+		return -1;
+	return (logical > previous ? logical - previous - 1
+		: logical - base + pages - previous - 1);
+}
